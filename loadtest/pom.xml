<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Deliberately NOT a module of the netty reactor. This is a load generator, not a unit of
       netty, and adding it to <modules> would put it in everyone's build for no benefit. Build it
       on its own: mvn -f loadtest/pom.xml package -->
  <groupId>io.netty.loadtest</groupId>
  <artifactId>netty-tls-loadtest</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <netty.version>4.2.18.Final-SNAPSHOT</netty.version>
    <!-- linux-x86_64 or linux-aarch_64; must match the host the test runs on. -->
    <native.classifier>linux-x86_64</native.classifier>
    <!-- Separate from native.classifier only so a QUIC-only smoke test can be built for a
         developer machine (osx-aarch_64) while the epoll and io_uring jars stay on their Linux
         classifier. Every measured run leaves this at the default. -->
    <quic.classifier>${native.classifier}</quic.classifier>
    <tcnative.artifactId>netty-tcnative-boringssl-static</tcnative.artifactId>
    <tcnative.version>2.0.82.Final-SNAPSHOT</tcnative.version>
  </properties>

  <repositories>
    <repository>
      <id>central-portal-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler</artifactId>
      <version>${netty.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-epoll</artifactId>
      <version>${netty.version}</version>
      <classifier>${native.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-io_uring</artifactId>
      <version>${netty.version}</version>
      <classifier>${native.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-pkitesting</artifactId>
      <version>${netty.version}</version>
    </dependency>
    <!-- QUIC. The native artifact carries quiche and BoringSSL and pulls netty-codec-classes-quic
         with it. Released builds of this do not load on Alpine, which is why every QUIC cell here
         runs on a glibc image. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-native-quic</artifactId>
      <version>${netty.version}</version>
      <classifier>${quic.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>${tcnative.artifactId}</artifactId>
      <version>${tcnative.version}</version>
      <classifier>${native.classifier}</classifier>
    </dependency>
    <!-- Percentiles over millions of samples need a histogram, not a list. Nothing in netty's
         build provides one. -->
    <dependency>
      <groupId>org.hdrhistogram</groupId>
      <artifactId>HdrHistogram</artifactId>
      <version>2.2.2</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>loadtest</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.netty.loadtest.LoadTest</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
